# Copy this file to .env and fill in your values.
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq, local LLM servers, etc.)

# URL of the OpenAI-compatible API
AI_MODE_BASE_URL=https://api.openai.com/v1

# API access token
AI_MODE_API_KEY=sk-your-key-here

# Default model id (used as "default" in the models map)
AI_MODE_MODEL=gpt-4o

# Optional: JSON map of model aliases, overrides AI_MODE_MODEL.
# Example:
# AI_MODE_MODELS={"default":"gpt-4o","cheap":"gpt-4o-mini"}
